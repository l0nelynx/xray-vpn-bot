# VCS
.git
.gitignore
.gitattributes

# IDE / OS
.idea
.vscode
*.iml
.DS_Store
Thumbs.db

# Python
__pycache__
**/__pycache__
*.py[cod]
*$py.class
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
env
ENV

# Local env & secrets — never bake into an image (pushed to GHCR). The runtime
# config is bind-mounted via docker-compose, so it must not be in the context.
.env
.env.*
!.env.example
config.yml

# Project: local databases & backups
db
*.sqlite3
*.sqlite3-*
db.sqlite3*

# Project: build artifacts shouldn't be in build context
web/apps/*/node_modules
web/apps/*/dist
web/packages/*/node_modules
node_modules

# Logs / runtime junk
*.log
logs
*.pid

# Docker — keep Dockerfiles in context; only ignore compose files
docker-compose*.yml

# Tests / docs we don't ship
tests
docs
*.md
!README.md
