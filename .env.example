# PostgreSQL credentials (required for docker-compose)
POSTGRES_USER=xray
POSTGRES_PASSWORD=changeme_strong
POSTGRES_DB=xray_vpn_bot
# Image registry and tag (see VERSION + docs/deployment.md)
# GHCR uses the GitHub owner; Docker Hub uses your hub username (see DOCKERHUB_USERNAME in CI secrets).
REGISTRY=ghcr.io/l0nelynx/
# REGISTRY=docker.io/<your-dockerhub-username>/
IMAGE_TAG=staging
REDIS_URL=redis://redis:6379/0
